<databaseChangeLog xmlns="http://www.liquibase.org/xml/ns/dbchangelog" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
                   xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-latest.xsd">

    <changeSet id="create-uuid-ossp-extension" author="aryan" runAlways="true">
        <sql>CREATE EXTENSION IF NOT EXISTS "uuid-ossp";</sql>
    </changeSet>

    <changeSet id="user-attributes-new-columns" author="aryan">
        <addColumn tableName="auth">
            
            <column name="created_at" type="timestamp" defaultValueComputed="CURRENT_TIMESTAMP">
                <constraints nullable="false"/>
            </column>
            <column name="organization_id" type="varchar(255)" defaultValueComputed="uuid_generate_v4()">
                <constraints nullable="false"/>
            </column>
            <column name="organization_name" type="varchar(255)" defaultValueComputed="''">
                <constraints nullable="false"/>
            </column>
            <column name="role" type="varchar(255)" defaultValueComputed="'STUDENT'">
                <constraints nullable="false"/>
            </column>
            <column name="payment_type" type="varchar(255)" defaultValueComputed="'FREE'">
                <constraints nullable="false"/>
            </column>
        </addColumn>
    </changeSet>
    <changeSet id="user-attributes-drop-columns" author="aryan">
        <dropColumn tableName="auth" columnName="payment_status" />
        <dropColumn tableName="auth" columnName="customer_type" />
    </changeSet>
   
   
</databaseChangeLog>