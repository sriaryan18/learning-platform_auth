<databaseChangeLog xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
                   xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
                   xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-latest.xsd">

    <changeSet id="update-organizationid-default" author="aryan">
       
        <sql>
            UPDATE auth SET organization_id = 'LMS_ORGANIZATION', organization_name = 'LMS_ORGANIZATION';
        </sql>
        <sql>
            ALTER TABLE auth ALTER COLUMN organization_id SET DEFAULT 'LMS_ORGANIZATION';
        </sql>
        <sql>
            ALTER TABLE auth ALTER COLUMN organization_name SET DEFAULT 'LMS_ORGANIZATION';
        </sql>
    </changeSet>

</databaseChangeLog> 